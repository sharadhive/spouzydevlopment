.hero-tip-rail{display:grid;grid-template-rows:minmax(0,3fr) minmax(0,2fr);min-width:0;overflow:hidden;border:1px solid #d5b9a9;border-radius:clamp(18px,1.8vw,30px)}
.hero-tip-photos{position:relative;min-height:0;overflow:hidden;background:#d8c5b7}
.hero-tip-photos img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 40%}
.hero-tip-photos img[hidden]{display:none}
.hero-tip-badge-top{
  position:absolute;
  top:14px;
  left:14px;
  z-index:5;
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:5px 13px;
  background:rgba(30,14,21,0.78);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  border:1px solid rgba(255,218,204,0.38);
  border-radius:999px;
  color:#fffaf5;
  font-size:10.5px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.11em;
  box-shadow:0 4px 14px rgba(0,0,0,0.35);
  pointer-events:none;
}
.hero-tip-pulse-dot{
  display:inline-block;
  width:6px;
  height:6px;
  border-radius:50%;
  background:#e08b73;
  box-shadow:0 0 8px rgba(224,139,115,0.9);
  animation:tipPulseDot 2s ease-in-out infinite;
  flex-shrink:0;
}
@keyframes tipPulseDot{
  0%,100%{transform:scale(1);opacity:1}
  50%{transform:scale(1.35);opacity:0.65}
}
.hero-tip-note{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:10px;min-width:0;padding:clamp(12px,1.55vw,24px);background:#36282a}
