/* ==========================================================================
   FOOTER TRUST, PAYMENT & SOCIAL STRIP
   Luxury dark theme alignment with crisp, perfectly scaled logo badges
   ========================================================================== */

.sp-footer-extras {
  display: flex !important;
  justify-content: flex-start !important;
  align-items: flex-start !important;
  flex-wrap: wrap !important;
  gap: 32px !important;
  padding: 20px 0 16px !important;
  margin: 20px auto 14px !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
  max-width: 1440px !important;
  box-sizing: border-box !important;
}

.sp-footer-extra {
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  gap: 8px !important;
}

.sp-footer-extras > .sp-footer-extra:last-child {
  margin-left: auto !important;
}

.sp-footer-extras .sp-footer-col-title {
  margin: 0 !important;
  font-size: 11.5px !important;
  font-weight: 800 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.12em !important;
  color: #e08b73 !important;
  line-height: 1.2 !important;
}

/* Payment and Initiative Badges (Transparent, directly on dark background) */
.sp-footer-badge-card {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  height: auto !important;
  min-height: 0 !important;
  box-shadow: none !important;
  transition: transform 0.2s ease !important;
}

.sp-footer-badge-card:hover {
  transform: none !important;
  box-shadow: none !important;
  border: none !important;
}

/* Force override of any generic .sp-footer-modern img constraints */
.sp-footer-logo-strip,
.sp-footer-badge-card img,
.sp-footer-modern .sp-footer-badge-card img,
.sp-footer-modern img.sp-footer-logo-strip {
  height: 46px !important;
  max-height: 46px !important;
  width: auto !important;
  max-width: 100% !important;
  object-fit: contain !important;
  display: block !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  filter: none !important;
  border: none !important;
  border-radius: 0 !important;
}

/* ==========================================================================
   FOOTER SOCIAL MEDIA ICONS
   Vibrant brand-colored circular icons (38-42px) with accessible states
   ========================================================================== */

.sp-footer-social-col,
.sp-footer-extras > .sp-footer-extra.sp-footer-social-col,
.sp-footer-extras > .sp-footer-extra:last-child {
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  justify-content: center !important;
  align-self: center !important;
  margin-left: auto !important;
  gap: 0 !important;
  padding: 0 !important;
}

.sp-footer-social,
.sp-footer-share {
  display: inline-flex !important;
  align-items: center !important;
  gap: 12px !important;
  height: auto !important;
  min-height: 46px !important;
}

.sp-footer-social-btn,
.sp-footer-social a,
.sp-footer-social span,
.sp-footer-share a {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 40px !important;
  height: 40px !important;
  min-width: 40px !important;
  min-height: 40px !important;
  border-radius: 50% !important;
  border: none !important;
  color: #ffffff !important;
  text-decoration: none !important;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.35) !important;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, filter 0.2s ease !important;
  flex-shrink: 0 !important;
  box-sizing: border-box !important;
  cursor: pointer !important;
  padding: 0 !important;
  overflow: hidden !important;
}

.sp-footer-social-btn svg,
.sp-footer-social a svg,
.sp-footer-social span svg,
.sp-footer-share a svg {
  display: block !important;
  pointer-events: none !important;
  flex-shrink: 0 !important;
}

/* Brand Colors */
.sp-footer-social-btn.sp-social-fb,
.sp-footer-social a.sp-social-fb {
  background: #1877F2 !important;
  border: none !important;
}

.sp-footer-social-btn.sp-social-x,
.sp-footer-social a.sp-social-x {
  background: #000000 !important;
  border: 1px solid rgba(255, 255, 255, 0.22) !important;
}

.sp-footer-social-btn.sp-social-li,
.sp-footer-social a.sp-social-li {
  background: #0A66C2 !important;
  border: none !important;
}

.sp-footer-social-btn.sp-social-ig,
.sp-footer-social span.sp-social-ig,
.sp-footer-social a.sp-social-ig {
  background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%) !important;
  border: none !important;
}

/* Interactive States: subtle hover & keyboard focus */
.sp-footer-social-btn:not(.sp-social-placeholder):hover,
.sp-footer-social a:not(.sp-social-placeholder):hover,
.sp-footer-share a:hover {
  transform: translateY(-2px) scale(1.06) !important;
  filter: brightness(1.12) !important;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.45) !important;
}

.sp-footer-social-btn:focus-visible,
.sp-footer-social a:focus-visible,
.sp-footer-social span:focus-visible,
.sp-footer-share a:focus-visible {
  outline: 2px solid #e08b73 !important;
  outline-offset: 3px !important;
}

/* Instagram Placeholder (profile URL pending) */
.sp-footer-social-placeholder,
.sp-social-placeholder {
  cursor: default !important;
  pointer-events: auto !important;
}

.sp-footer-social-placeholder:hover,
.sp-social-placeholder:hover {
  transform: none !important;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.35) !important;
  filter: none !important;
}

@media (prefers-reduced-motion: reduce) {
  .sp-footer-social-btn,
  .sp-footer-social a,
  .sp-footer-share a {
    transition: none !important;
    transform: none !important;
  }
  .sp-footer-social-btn:hover,
  .sp-footer-social a:hover,
  .sp-footer-share a:hover {
    transform: none !important;
  }
}

@media (max-width: 820px) {
  .sp-footer-extras {
    justify-content: flex-start !important;
    gap: 24px !important;
    padding: 18px 0 14px !important;
    margin: 18px auto 14px !important;
  }
  .sp-footer-extras > .sp-footer-extra:last-child,
  .sp-footer-social-col {
    margin-left: 0 !important;
    width: 100% !important;
    align-self: flex-start !important;
  }
