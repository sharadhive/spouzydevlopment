# Node Environment & Server Port
NODE_ENV=development
PORT=5000

# Local MySQL Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spouzy_dev
DB_USER=root
DB_PASSWORD=root

# Test Database Settings (Used by npm test)
DB_NAME_TEST=spouzy_test

# Public & Admin URLs (CORS & Redirection)
PUBLIC_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# Cryptographic & Session Secrets (Change in production!)
SESSION_SECRET=spouzy_super_secret_session_key_2026_dev_random_token_998877
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CSRF_SECRET=spouzy_csrf_protection_secret_2026_change_in_prod

# Upload Storage Paths (Relative to backend/ or absolute)
STORAGE_PATH=./storage

# Razorpay Default Test Gateway (Optional fallback; configurable in admin)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public Helpline & WhatsApp Settings
SPOUZY_WHATSAPP_NUMBER=+918591945055
SPOUZY_SUPPORT_EMAIL=care@spouzy.com
